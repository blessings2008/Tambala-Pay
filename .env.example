NODE_ENV=development
PORT=3000

# Use a long random value. This protects the internal dashboard/API.
INTERNAL_ACCESS_TOKEN=replace-with-a-long-random-secret

# Supabase PostgreSQL connection string from Project Dashboard > Connect.
# For Render, prefer the Supabase Session Pooler connection string if IPv6 direct access is unavailable.
# Keep this secret on the server only; never place it in frontend code.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# PayChangu test secret key first. Never put this value in frontend code.
PAYCHANGU_SECRET_KEY=
# HMAC webhook secret configured in PayChangu dashboard (if provided).
PAYCHANGU_WEBHOOK_SECRET=

# Public HTTPS base URL when deployed, e.g. https://your-service.onrender.com
APP_BASE_URL=http://localhost:3000

# Supabase requires SSL for remote database connections.
DATABASE_SSL=true
