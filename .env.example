NODE_ENV=development
PORT=3000

# Use a long random value. This protects the internal dashboard/API.
INTERNAL_ACCESS_TOKEN=replace-with-a-long-random-secret

# PostgreSQL connection string (Supabase or another managed PostgreSQL service).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# PayChangu test secret key first. Never put this value in frontend code.
PAYCHANGU_SECRET_KEY=
# HMAC webhook secret configured in PayChangu dashboard (if provided).
PAYCHANGU_WEBHOOK_SECRET=

# Public HTTPS base URL when deployed, e.g. https://your-service.onrender.com
APP_BASE_URL=http://localhost:3000

# Set true only if your PostgreSQL provider requires SSL.
DATABASE_SSL=true
